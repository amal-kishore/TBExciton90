! ============================================================
! Wannier90 input for InSe monolayer
! 16 Wannier functions: s+p on each of the 4 atoms (2 In + 2 Se)
! Total valence electrons: 38 -> 19 occupied bands
! In: 13 val e (4d10 5s2 5p1), Se: 6 val e (4s2 4p4)
! ============================================================

num_bands = 36
num_wann  = 16

! ============================================================
! DISENTANGLEMENT WINDOWS
! After running SCF, get Fermi energy from:
!   grep "the Fermi energy is" ../scf/scf.out
! Then set the windows (all values in eV, absolute scale):
!   dis_win_min  = EFERMI - 13.0   ! just above deep In 4d bands
!   dis_win_max  = EFERMI + 4.0    ! above conduction band minimum
!   dis_froz_min = EFERMI - 13.0   ! same as dis_win_min
!   dis_froz_max = EFERMI + 2.0    ! ~1 eV above conduction band minimum
! Replace the placeholder values below with actual EFERMI-based values
! ============================================================
! Windows chosen following /home/amalkishore/work/wannierization/wannierization_guide.md §4.4
! - dis_win_min in real gap above In 4d (top at -14.7 eV)
! - dis_win_max tightened to keep the 16 WFs from being under-constrained
! - dis_froz_max sits in the VBM-CBM semiconductor gap (VBM=-1.127, CBM=+0.320)
dis_win_min  = -14.00
dis_win_max  =  15.00    ! wide enough to keep >=16 bands at every k in the 36-band NSCF
dis_froz_min = -14.00
dis_froz_max =  -0.40    ! in the VBM-CBM gap (0.72 eV above VBM, 0.72 eV below CBM)

dis_num_iter  = 3000     ! previous 500 did not converge; raise significantly
num_iter      = 2000
conv_tol      = 1.0d-10
guiding_centres = true   ! keep WFs anchored on atoms (guide §13.2)

! Output
write_hr           = true
write_u_matrices   = true
write_xyz          = true
hr_cutoff          = 0.0

! Band structure interpolation (2D hexagonal path: G-M-K-G)
bands_plot        = true
bands_num_points  = 100
bands_plot_format = gnuplot

begin kpoint_path
G  0.00000  0.00000  0.00000   M  0.50000  0.00000  0.00000
M  0.50000  0.00000  0.00000   K  0.33333  0.33333  0.00000
K  0.33333  0.33333  0.00000   G  0.00000  0.00000  0.00000
end kpoint_path

! Unit cell in Bohr — exact values from QE XML (scf/out/inse.save/data-file-schema.xml)
begin unit_cell_cart
Bohr
  7.699206864700000   0.000000000000000   0.000000000000000
 -3.849603432350000   6.667708733821739   0.000000000000000
  0.000000000000000   0.000000000000000  38.488630581397930
end unit_cell_cart

begin atoms_frac
In   0.66667   0.33333   0.43060
In   0.66667   0.33333   0.56940
Se   0.33333   0.66667   0.36754
Se   0.33333   0.66667   0.63246
end atoms_frac

! Initial projections: s and p orbitals on all atoms
begin projections
In : s;p
Se : s;p
end projections

mp_grid : 16 16 1

! k-points generated by: kmesh.pl 8 8 1
